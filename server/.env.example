# ==============================================================================
# Social365 Server Environment Configuration Example
# Copy this file to .env and configure your production or local secrets
# ==============================================================================

# Server Listening Port
PORT=5000

# Application Environment (development | production)
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/social365

# Client Origin (CORS whitelist)
CLIENT_URL=http://localhost:5173

